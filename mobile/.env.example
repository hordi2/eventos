# URL de base de l'API de check-in (T-060), sans slash final.
# Jamais "localhost" pour un appareil physique — utiliser l'IP locale de la
# machine qui sert l'API Laravel (ex. http://192.168.1.42:8000/api/v1) ou une
# URL publique/tunnel (ngrok, Expo Tunnel) pour un poste hors du même réseau.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
