includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    level: 6

    tmpDir: storage/framework/phpstan

    # Le projet utilise la syntaxe casts(): array (recommandée depuis
    # Laravel 11) plutôt que la propriété $casts. Sans cette option,
    # Larastan ne détecte pas les casts vers une classe enum (ex.
    # MembershipRole) et infère le type brut de la colonne (string) au lieu
    # du type de l'enum, faussant toute comparaison stricte en aval.
    parseModelCastsMethod: true

    ignoreErrors:
        -
            # BelongsToOrganization est prêt à être utilisé par les futurs
            # modèles de Domain/ (T-010+), mais aucun n'existe encore : rien
            # dans app/ ne l'utilise pour l'instant, ce que PHPStan signale.
            # Sa correction est vérifiée par des tests (voir
            # tests/Feature/Organization/MultiTenantIsolationTest.php).
            # À retirer dès qu'un premier modèle métier réel l'utilise.
            identifier: trait.unused
            path: app/Support/MultiTenancy/BelongsToOrganization.php
